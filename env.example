# ============================================================
# RAG Chatbot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# LLM PRIORITY ORDER:
#   1. OpenAI (best quality — requires paid account)
#   2. Groq  (fastest — free tier fallback)
#   3. Neither set = local FLAN-T5 (slow on CPU, no API needed)
# ============================================================


# ------------------------------------------------------------
# OPTION 1: OpenAI (Best quality, used first if set)
# Get a key at: https://platform.openai.com
# Requires a paid account. gpt-5-mini: ~$0.25/1M input, $2/1M output
# tokens (roughly $0.001-0.002/query for a typical RAG answer).
# gpt-3.5-turbo is retiring Oct 23, 2026 — do not use it for new setups.
# gpt-5.x models don't accept `temperature` (app handles this
# automatically — see app/rag_pipeline.py get_llm()).
# ------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# ------------------------------------------------------------
# OPTION 2: Groq (fast, free-tier fallback)
# Get a free key at: https://console.groq.com
# Free tier: 14,400 requests/day — plenty for personal use
# Speed: ~1 second per response
# Check https://console.groq.com/docs/models for current models —
# Groq deprecates models periodically (e.g. llama3-8b-8192 and
# llama-3.3-70b-versatile were retired June 2026).
# ------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b


# ------------------------------------------------------------
# Qdrant Cloud  (online vector DB — used when internet is available)
# Get a free cluster at: https://cloud.qdrant.io  (no credit card)
# Leave empty to use FAISS local storage instead
# ------------------------------------------------------------
QDRANT_URL=https://xxxx-xxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here


# ------------------------------------------------------------
# Embeddings
# EMBEDDING_MODEL is the local HuggingFace fallback — only used when
# OPENAI_API_KEY is NOT set. If OPENAI_API_KEY is set, OPENAI_EMBEDDING_MODEL
# (above) is used instead, regardless of this value.
# ------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# ------------------------------------------------------------
# RAG Settings (optional tuning)
# ------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Chunking strategy:
#   fixed     — RecursiveCharacterTextSplitter, fixed size + overlap (default, baseline)
#   structure — split on detected section headers first, recursive-split within
#               oversized sections (Markdown ATX, numbered sections, ALL-CAPS lines)
#   semantic  — split on topic boundaries via embedding-similarity between
#               consecutive sentences (one extra embedding call per sentence —
#               slower/pricier to build, may improve recall on unstructured docs)
# Compare all three on your own corpus: python compare_chunking_strategies.py
CHUNKING_STRATEGY=fixed
SEMANTIC_CHUNK_BREAKPOINT_PERCENTILE=90   # semantic only — higher = fewer, bigger chunks
SEMANTIC_CHUNK_MIN_CHARS=200              # semantic only — merge chunks smaller than this

# Near-duplicate dedup — after exact-hash dedup, also drops chunks that are
# near-identical (cosine similarity > threshold) to one already kept, e.g. the
# same info paraphrased across two source documents. Reuses the embedding model
# already loaded for the vector store, so it's on by default (no extra API cost).
NEAR_DUP_DEDUP_ENABLED=true
NEAR_DUP_THRESHOLD=0.95

# Composite confidence score — combines retrieval confidence (reranker score),
# citation coverage (% of claims with a citation), and answer completeness
# (grade-based heuristic) into one 0-1 number shown next to every answer.
# All three are free (no extra LLM calls) so this always runs. Weights are
# normalized automatically, so they don't need to sum to exactly 1.
CONFIDENCE_WEIGHT_RETRIEVAL=0.5
CONFIDENCE_WEIGHT_COVERAGE=0.3
CONFIDENCE_WEIGHT_COMPLETENESS=0.2

RETRIEVAL_K=3            # Final docs passed to LLM after reranking
RETRIEVAL_K_INITIAL=10   # Docs fetched from FAISS before reranking (fetch more, keep best)
SEARCH_TYPE=similarity

# RRF fusion weight for dense (FAISS/Qdrant) vs sparse (BM25) results when hybrid
# retrieval combines them. Sparse weight is always (1 - this). 0.5 = unweighted
# (default, today's behavior). Try 0.7 to favor semantic matches on conceptual
# questions, or 0.3 to favor exact keyword matches on technical docs with specific
# function names / config keys / error codes.
RRF_DENSE_WEIGHT=0.5

# Contextual Retrieval (Anthropic technique) — before embedding each chunk,
# an LLM writes a 1-2 sentence summary of where it sits in the document, which
# is prepended to the chunk. Meaningfully improves retrieval on chunks that
# read as ambiguous in isolation. Costs one extra LLM call per chunk at
# document-load time (parallelized). Requires Groq or OpenAI configured.
CONTEXTUAL_RETRIEVAL=false
CONTEXTUAL_RETRIEVAL_MAX_DOC_CHARS=30000   # cap on document text sent per chunk call


# ------------------------------------------------------------
# Reranker + CRAG Grading
# ------------------------------------------------------------
# Cross-encoder model for reranking retrieved chunks
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# CRAG grade thresholds (ms-marco scores range roughly -10 to +10)
# Chunks scoring below GRADE_AMBIGUOUS_THRESHOLD are discarded
# If best chunk < GRADE_AMBIGUOUS_THRESHOLD → refuse to answer (INCORRECT)
GRADE_CORRECT_THRESHOLD=-2.0
GRADE_AMBIGUOUS_THRESHOLD=-5.0

# Rewrite follow-up questions as standalone before retrieval (true/false)
CONDENSE_QUESTIONS=true

# Split complex multi-part questions into sub-queries before retrieval (true/false)
DECOMPOSE_QUERIES=true

# ------------------------------------------------------------
# Semantic Cache (in-memory, per loaded document)
# ------------------------------------------------------------
# Cosine similarity threshold — questions above this score return cached answers
# 0.92 = very similar, 0.85 = loosely similar
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_SIZE=100

# ------------------------------------------------------------
# Redis  (persistent semantic cache — survives app restarts)
# ------------------------------------------------------------
# Local Redis (after: brew services start redis)
REDIS_URL=redis://localhost:6379
# Redis Cloud free tier: redis://:password@host:port
# Leave empty to use in-memory cache instead
REDIS_CACHE_TTL=86400   # seconds — 86400 = 24 hours


# ------------------------------------------------------------
# LLM Generation Settings
# LLM_TEMPERATURE — ignored for gpt-5.x models (they use reasoning_effort
#   instead, set automatically to "minimal" in code).
# LLM_MAX_LENGTH — only used by the local FLAN-T5 fallback.
# LLM_MAX_OUTPUT_TOKENS — max_tokens cap for Groq/OpenAI. Keep this generous
#   (400+) for gpt-5.x: they spend part of the budget on hidden reasoning
#   tokens before any visible output, so a too-low cap can return an empty
#   answer even with reasoning_effort="minimal".
# ------------------------------------------------------------
LLM_TEMPERATURE=0.3
LLM_MAX_LENGTH=512
LLM_MAX_OUTPUT_TOKENS=800


# ------------------------------------------------------------
# RAGAS Evaluation  (answer quality scoring — on demand)
# pip install ragas datasets
# Set true to enable the "Evaluate Last Answer" button in the UI
# Uses your configured Groq or OpenAI LLM as judge — no extra API key needed
# ------------------------------------------------------------
RAGAS_EVAL=false

# HyDE — Hypothetical Document Embeddings (improves conceptual query recall)
# Generates a hypothetical answer, embeds that instead of the raw question
# Adds ~1 extra LLM call per query — disable if latency is critical
HYDE_ENABLED=false

# How many prior Q&A turns to include in the LLM answer prompt
# 0 = no history passed to LLM, 2 = last 2 exchanges (recommended)
HISTORY_TURNS=2


# ------------------------------------------------------------
# LangSmith  (chain tracing & latency — optional observability)
# Get a free key at: https://smith.langchain.com
# When LANGCHAIN_API_KEY is set, all LangChain calls are auto-traced
# ------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=rag-chatbot-v2
